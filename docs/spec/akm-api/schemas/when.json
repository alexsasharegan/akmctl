{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akm.invalid/api/1.0/when.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "as_of": {
          "$ref": "common.json#/$defs/date"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "const": "1.0"
            },
            "operation": {
              "const": "when"
            },
            "request": {
              "type": "object"
            },
            "ok": {
              "const": true
            },
            "id": {
              "$ref": "common.json#/$defs/id"
            },
            "date": {
              "$ref": "common.json#/$defs/date"
            },
            "weekday": {
              "enum": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday"
              ]
            },
            "age_days": {
              "type": "integer"
            }
          },
          "required": [
            "api_version",
            "operation",
            "request",
            "ok",
            "id",
            "date",
            "weekday",
            "age_days"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "common.json#/$defs/envelope_error"
        }
      ]
    }
  }
}
