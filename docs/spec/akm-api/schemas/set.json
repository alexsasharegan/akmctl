{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akm.invalid/api/1.0/set.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "changes": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "cycle": {
              "oneOf": [
                {
                  "$ref": "common.json#/$defs/cycle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "keep": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "closed": false
          }
        },
        "if_match": {
          "$ref": "common.json#/$defs/etag"
        },
        "as_of": {
          "$ref": "common.json#/$defs/date_or_timestamp"
        },
        "dry_run": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "changes"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "const": "1.0"
            },
            "operation": {
              "const": "set"
            },
            "request": {
              "type": "object"
            },
            "ok": {
              "const": true
            },
            "record": {
              "$ref": "common.json#/$defs/record"
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "diff": {
              "$ref": "common.json#/$defs/diff"
            }
          },
          "required": [
            "api_version",
            "operation",
            "request",
            "ok",
            "record",
            "changed"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "common.json#/$defs/envelope_error"
        }
      ]
    }
  }
}
