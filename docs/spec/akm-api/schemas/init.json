{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akm.invalid/api/1.0/init.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "code",
            "notes"
          ]
        },
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "git_commits": {
          "type": "boolean"
        },
        "git_init": {
          "type": "boolean"
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "const": "1.0"
            },
            "operation": {
              "const": "init"
            },
            "request": {
              "type": "object"
            },
            "ok": {
              "const": true
            },
            "profile": {
              "enum": [
                "code",
                "notes"
              ]
            },
            "dir": {
              "type": "string",
              "minLength": 1
            },
            "layout": {
              "$ref": "common.json#/$defs/version"
            },
            "written": {
              "type": "array",
              "items": {
                "$ref": "common.json#/$defs/path"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "$ref": "common.json#/$defs/path"
              }
            },
            "git_commits": {
              "type": "boolean"
            },
            "git": {
              "enum": [
                "none",
                "initialised",
                "existing",
                "failed"
              ]
            },
            "git_error": {
              "type": "string",
              "minLength": 1
            },
            "git_commits_forced_off": {
              "type": "boolean"
            }
          },
          "required": [
            "api_version",
            "operation",
            "request",
            "ok",
            "profile",
            "dir",
            "layout",
            "written",
            "skipped",
            "git_commits",
            "git",
            "git_commits_forced_off"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "common.json#/$defs/envelope_error"
        }
      ]
    }
  }
}
