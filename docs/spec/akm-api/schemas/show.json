{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akm.invalid/api/1.0/show.json",
  "$defs": {
    "edit_state": {
      "type": "object",
      "properties": {
        "state": {
          "enum": ["yes", "warn", "no"]
        },
        "reason": {
          "type": "string"
        },
        "correction": {
          "const": true
        },
        "append": {
          "const": true
        }
      },
      "required": ["state"],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "section": {
          "type": "string"
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "const": "1.0"
            },
            "operation": {
              "const": "show"
            },
            "request": {
              "type": "object"
            },
            "ok": {
              "const": true
            },
            "record": {
              "$ref": "common.json#/$defs/record"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "edit": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/edit_state"
                  }
                },
                "sections": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/edit_state"
                  }
                }
              },
              "required": ["fields", "sections"],
              "additionalProperties": false
            },
            "body": {
              "type": "string"
            },
            "section": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": ["name", "text"],
              "additionalProperties": false
            }
          },
          "required": [
            "api_version",
            "operation",
            "request",
            "ok",
            "record",
            "sections"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "common.json#/$defs/envelope_error"
        }
      ]
    }
  }
}
