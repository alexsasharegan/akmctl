{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akm.invalid/api/1.0/show.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "section": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "const": "1.0"
            },
            "operation": {
              "const": "show"
            },
            "request": {
              "type": "object"
            },
            "ok": {
              "const": true
            },
            "record": {
              "$ref": "common.json#/$defs/record"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "body": {
              "type": "string"
            },
            "section": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "api_version",
            "operation",
            "request",
            "ok",
            "record",
            "sections"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "common.json#/$defs/envelope_error"
        }
      ]
    }
  }
}
