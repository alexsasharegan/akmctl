{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akm.invalid/api/1.0/log.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "if_match": {
          "$ref": "common.json#/$defs/etag"
        },
        "section_etag": {
          "$ref": "common.json#/$defs/etag"
        },
        "dry_run": {
          "type": "boolean"
        },
        "as_of": {
          "$ref": "common.json#/$defs/date_or_timestamp"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_version": {
              "const": "1.0"
            },
            "operation": {
              "const": "log"
            },
            "request": {
              "type": "object"
            },
            "ok": {
              "const": true
            },
            "record": {
              "$ref": "common.json#/$defs/record"
            },
            "diff": {
              "$ref": "common.json#/$defs/diff"
            },
            "section": {
              "$ref": "common.json#/$defs/section_etag_text"
            },
            "changed": {
              "type": "boolean"
            },
            "entry": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "api_version",
            "operation",
            "request",
            "ok",
            "record",
            "section",
            "entry",
            "changed"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "common.json#/$defs/envelope_error"
        }
      ]
    }
  }
}
